        "INSERT INTO audit_log (case_id, action, actor, tool, query, result) VALUES ($1, $2, $3, $4, $5, $6)",
        "SYSTEM", "POLICE_LOGIN", officer["email"], "AUTH", client_ip, "SUCCESS"
    )
    await conn.close()
    
    return {
        "token": token,
        "officer": {
            "id": officer["id"],
            "name": officer["name"],
            "email": officer["email"],
            "role": officer["role"],
            "agency": officer["agency"],
