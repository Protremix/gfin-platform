# GFIN Environment Variables — Example
# Copy to .env and fill in real values. NEVER commit .env.

# ─── General ───
GFIN_ENV=development
GFIN_LOG_LEVEL=INFO
GFIN_SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_KEY

# ─── Database (Layer A: Base44 / Layer B: PostgreSQL) ───
DATABASE_ADAPTER=base44
# PostgreSQL (Layer B):
# DATABASE_ADAPTER=postgresql
# DATABASE_URL=postgresql+asyncpg://gfin:password@localhost:5432/gfin

# ─── Event Bus (Layer A: in-memory / Layer B: Kafka) ───
EVENT_BUS_ADAPTER=memory
# Kafka (Layer B):
# EVENT_BUS_ADAPTER=kafka
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Search (Layer A: entity queries / Layer B: OpenSearch) ───
SEARCH_ADAPTER=entity
# OpenSearch (Layer B):
# SEARCH_ADAPTER=opensearch
# OPENSEARCH_URL=https://localhost:9200

# ─── Object Storage (Layer A: local / Layer B: S3) ───
STORAGE_ADAPTER=local
# S3 (Layer B):
# STORAGE_ADAPTER=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=gfin-evidence
# S3_ACCESS_KEY=REPLACE
# S3_SECRET_KEY=REPLACE

# ─── Graph (Layer A: adjacency list / Layer B: Neo4j) ───
GRAPH_ADAPTER=adjacency
# Neo4j (Layer B):
# GRAPH_ADAPTER=neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=REPLACE

# ─── Cache (Layer A: in-memory / Layer B: Redis) ───
CACHE_ADAPTER=memory
# Redis (Layer B):
# CACHE_ADAPTER=redis
# REDIS_URL=redis://localhost:6379/0

# ─── AI Model Gateway ───
MODEL_GATEWAY_ADAPTER=openai
OPENAI_PROJECT_KEY=set-via-secrets-management
# Fallback local model (Layer A):
# MODEL_GATEWAY_FALLBACK=local

# ─── Identity (Layer A: Base44 auth / Layer B: OIDC) ───
IDENTITY_ADAPTER=base44
# OIDC (Layer B):
# IDENTITY_ADAPTER=oidc
# OIDC_ISSUER=https://auth.gfin.example
# OIDC_CLIENT_ID=gfin
# OIDC_CLIENT_SECRET=REPLACE
