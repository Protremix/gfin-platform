    function setupPullToRefresh() {
      const container = document.getElementById('casesContainer');
      const indicator = document.getElementById('pullIndicator');
      let startY = 0;
      let pulling = false;

      container.addEventListener('touchstart', (e) => {
        if (window.scrollY === 0) {
          startY = e.touches[0].pageY;
          pulling = true;
        }
      }, { passive: true });

      container.addEventListener('touchmove', (e) => {
        if (!pulling) return;
        const diff = e.touches[0].pageY - startY;
        if (diff > 50) {
          indicator.style.display = 'flex';
        }
      }, { passive: true });

      container.addEventListener('touchend', () => {
        if (pulling && indicator.style.display === 'flex') {
          showToast('Refreshing intelligence grid...', 'info');
          loadDashboardData();
          setTimeout(() => {
            indicator.style.display = 'none';
          }, 800);
        }
        pulling = false;
      });
    }

    function setupSwipeOnCards() {
      document.querySelectorAll('.case-card').forEach(card => {
        let startX = 0;
        let currentX = 0;
        const inner = card.querySelector('.case-card-inner');

        card.addEventListener('touchstart', e => {
          startX = e.touches[0].clientX;
        }, { passive: true });

        card.addEventListener('touchmove', e => {
          currentX = e.touches[0].clientX;
          const diffX = currentX - startX;
          if (Math.abs(diffX) < 100) {
            inner.style.transform = `translateX(${diffX}px)`;
          }
        }, { passive: true });

        card.addEventListener('touchend', () => {
          const diffX = currentX - startX;
          if (diffX < -60) {
            const caseId = card.getAttribute('data-id');
            openCaseDetail(caseId);
            openEscalateModal();
          }
          inner.style.transform = 'translateX(0px)';
          startX = 0; currentX = 0;
        });
      });
    }

