    function checkAuth() {
      const token = localStorage.getItem('gfin_token');
      const exp = localStorage.getItem('gfin_token_exp');

      if (token && exp && Date.now() < parseInt(exp, 10)) {
        state.token = token;
        document.getElementById('loginView').style.display = 'none';
        document.getElementById('settingsJwt').textContent = token.substring(0, 32) + '...';
        loadDashboardData();
      } else {
        localStorage.removeItem('gfin_token');
        localStorage.removeItem('gfin_token_exp');
        state.token = null;
        document.getElementById('loginView').style.display = 'flex';
      }
    }

    function checkAuthExpiration() {
      const exp = localStorage.getItem('gfin_token_exp');
      if (exp && Date.now() >= parseInt(exp, 10)) {
        showToast('Session expired (7-day security limit). Log in again.', 'error');
        logout();
      }
    }

    function handleLogin(e) {
      e.preventDefault();
      const email = document.getElementById('loginEmail').value;
      const header = btoa(JSON.stringify({ alg: "HS256", typ: "JWT" }));
      const expTime = Date.now() + (7 * 24 * 60 * 60 * 1000); // 7 Days
      const payload = btoa(JSON.stringify({ sub: email, role: "POLICE_DISPATCH", exp: Math.floor(expTime / 1000) }));
      const signature = btoa("gfin_police_sig_2026");
      const jwtToken = `${header}.${payload}.${signature}`;

      localStorage.setItem('gfin_token', jwtToken);
      localStorage.setItem('gfin_token_exp', expTime.toString());
      state.token = jwtToken;

      document.getElementById('loginView').style.display = 'none';
      document.getElementById('settingsJwt').textContent = jwtToken.substring(0, 32) + '...';
      showToast('Authenticated as Law Enforcement Investigator', 'success');
      loadDashboardData();
    }

    function logout() {
      localStorage.removeItem('gfin_token');
      localStorage.removeItem('gfin_token_exp');
      state.token = null;
      document.getElementById('loginView').style.display = 'flex';
      showToast('Logged out', 'info');
    }

    async function fetchAPI(endpoint, options = {}) {
      const headers = {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${state.token}`,
        ...(options.headers || {})
      };

      try {
        const res = await fetch(endpoint, { ...options, headers });
        if (res.status === 401 || res.status === 403) {
          logout();
          throw new Error('Unauthorized');
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        return await res.json();
      } catch (err) {
        return getFallbackData(endpoint);
      }
    }

    function getFallbackData(endpoint) {
      if (endpoint.startsWith('/api/cases')) {
        if (endpoint.includes('/api/cases/')) {
          const id = endpoint.split('/api/cases/')[1];
          return state.cases.find(c => c.id === id) || generateMockCases()[0];
        }
        return generateMockCases();
      }
      if (endpoint.startsWith('/api/alerts')) {
        return generateMockAlerts();
      }
      if (endpoint.startsWith('/api/telegram/status')) {
        return { status: "ONLINE", monitored_channels: 184, last_sync: new Date().toISOString() };
      }
      return {};
    }

